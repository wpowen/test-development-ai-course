{
  "name": "test-development-ai-tutorial",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev",
    "build": "npm run validate:release && WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "validate:content": "node scripts/validate-content.ts",
    "validate:release": "node scripts/validate-content.ts --with-executability && node scripts/validate-reference-projection.ts",
    "audit:executability": "node scripts/audit-executability.ts",
    "generate:integrity": "node ../scripts/generate-course-integrity-manifests.mjs --write",
    "verify:integrity": "node ../scripts/generate-course-integrity-manifests.mjs",
    "test:integrity": "node --test ../scripts/generate-course-integrity-manifests.test.mjs",
    "validate:materials": "python3 scripts/validate-material-archives.py",
    "typecheck": "tsc --noEmit",
    "export:static": "npm run validate:release && node scripts/export-static.ts",
    "test:technical-blocks": "node --test tests/technical-block-contract.test.mjs",
    "test:agent-visuals": "node --test tests/agent-architecture-visuals.test.mjs",
    "test:static": "npm run export:static && node --test tests/static-export.test.mjs",
    "test": "npm run validate:content && npm run validate:materials && npm run typecheck && npm run test:agent-visuals && npm run build && node --test tests/rendered-html.test.mjs && npm run test:static",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "validate:projection": "node scripts/validate-reference-projection.ts"
  },
  "dependencies": {
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@eslint/js": "9.39.4",
    "@next/eslint-plugin-next": "16.2.6",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "eslint": "9.39.4",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "16.4.0",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.59.3",
    "vinext": "1.0.0-beta.2",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
