{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "risk-test-plan.v1.1",
  "type": "object",
  "required": [
    "page_id",
    "status",
    "risks",
    "method_decisions",
    "test_level_map",
    "blocked",
    "unknowns"
  ],
  "properties": {
    "page_id": {
      "const": "TD-P04"
    },
    "status": {
      "enum": [
        "ACCEPTED",
        "PASS",
        "PARTIAL",
        "BLOCKED",
        "UNKNOWN",
        "RELEASE_CANDIDATE"
      ]
    },
    "risks": {
      "type": "array",
      "description": "Professional output records for risks",
      "items": {
        "type": "object"
      }
    },
    "method_decisions": {
      "type": "array",
      "description": "Professional output records for method_decisions",
      "items": {
        "type": "object"
      }
    },
    "test_level_map": {
      "type": "array",
      "description": "Professional output records for test_level_map",
      "items": {
        "type": "object"
      }
    },
    "blocked": {
      "type": "array",
      "description": "Professional output records for blocked",
      "items": {
        "type": "object"
      }
    },
    "unknowns": {
      "type": "array",
      "description": "Professional output records for unknowns",
      "items": {
        "type": "object"
      }
    }
  },
  "additionalProperties": false
}
